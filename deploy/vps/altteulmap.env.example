# VPS의 비밀 경로(예: /opt/altteulmap/altteulmap.env, chmod 600)로 복사해 채운다. 저장소에 커밋하지 않는다.
POSTGRES_DB=altteulmap
POSTGRES_USER=altteulmap_admin
POSTGRES_PASSWORD=change-me-long-random
# 런타임(Worker)이 쓰는 최소 권한 role의 비밀번호. grant-app-role.sh가 사용한다.
APP_DB_PASSWORD=change-me-another-long-random
# Cloudflare Zero Trust > Networks > Tunnels 에서 발급한 토큰
TUNNEL_TOKEN=change-me
