<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 매월 1일 10:00에 VPS 백업 사본을 가져온다(맥이 꺼져 있었다면 다음에 깨어날 때 실행). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.altteulmap.backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/pull-vps-backup.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>BACKUP_PULL_KEEP</key>
    <string>12</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/backups/vps/pull.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/backups/vps/pull.log</string>
</dict>
</plist>
